{
  "openapi": "3.0.3",
  "info": {
    "title": "Expiring Pastebin API",
    "version": "1.0.0",
    "description": "High-performance encrypted and expiring code snippet service powered by Upstash Redis."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check endpoint",
        "responses": {
          "200": { "description": "API and Redis connection operational" },
          "503": { "description": "Service degraded" }
        }
      }
    },
    "/api/snippets": {
      "post": {
        "summary": "Create a new expiring snippet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 100,
                    "default": "Untitled"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500000
                  },
                  "language": { "type": "string", "default": "plaintext" },
                  "ttlSeconds": {
                    "type": "integer",
                    "description": "TTL in seconds (0 = Burn After Read)"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 64
                  },
                  "maxViews": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Snippet created successfully" },
          "400": { "description": "Validation failure" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/snippets/{id}": {
      "get": {
        "summary": "Retrieve snippet by unique ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "password",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Snippet found (code is null if protected and not unlocked)"
          },
          "404": { "description": "Snippet expired or does not exist" }
        }
      },
      "delete": {
        "summary": "Delete snippet manually",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Snippet deletion status" }
        }
      }
    },
    "/api/snippets/{id}/unlock": {
      "post": {
        "summary": "Unlock a password-protected snippet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Snippet unlocked" },
          "401": { "description": "Incorrect password" },
          "404": { "description": "Snippet expired or not found" }
        }
      }
    }
  }
}
